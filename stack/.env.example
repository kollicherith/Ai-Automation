# Copy to .env on the VM. scripts/deploy.sh generates this for you.
# chmod 600 .env - it holds the key that decrypts every stored credential.

DOMAIN=SUBDOMAIN.duckdns.org

# Generate with: openssl rand -hex 32
# Losing this makes every credential stored in n8n permanently unreadable.
N8N_ENCRYPTION_KEY=

GENERIC_TIMEZONE=Europe/Dublin

# Optional tuning (defaults applied in docker-compose.yml if unset)
N8N_LOG_LEVEL=warn
EXECUTIONS_DATA_MAX_AGE=168
