# --- Secrets: never commit these ---
# The encryption key decrypts every stored credential; the exports are plaintext.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Rendered at deploy time from Caddyfile.template
stack/Caddyfile

# Backups contain DECRYPTED credentials and the encryption key
backups/
*.tar.gz
*.tar.gz.age
stack/files/
**/files/

# OCI launch payload - tenancy/compartment OCIDs and your SSH key
launch.json

# Keys
*.pem
*.key
id_rsa*
id_ed25519*
identity.txt
recipient.txt

# --- Noise ---
*.log
.DS_Store
